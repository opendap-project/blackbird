#!/bin/sh
# odap-reboot: restart into a boot mode of this device. The device knows its own modes; the opendap
# CLI (device reboot --mode) and virtual-devices (odap-vdev reboot) call this instead of imitating
# the button combinations, which stay a way to test the buttons.
#
# Usage: odap-reboot [MODE]     restart into MODE (default: normal)
#        odap-reboot --list     the modes this device has, one per line
#        odap-reboot --serve    one request on standard input, for blackbird-power.socket: `list`,
#                               `poweroff` or `reboot MODE`; answers `ok`, the list, or `error: …`
#
# Modes:
#   normal    the product boot
#   debug     the debug boot mode, once (the boot entry's "debug" profile, OS-035), if the image has it
#   others    from the board support package: an executable /usr/lib/opendap/boot-modes.d/<MODE>
#             that prepares the next boot into it (recovery, maskrom…); without one, the mode is absent
#
# Errors carry a stable code, a hint and a fix (mode.unknown, mode.no_debug_entry, boot.select_failed,
# boot.prepare_failed, input.invalid). The --serve answers stay `ok`, the list or `error: …`.
#
# Exit status: 0 the restart is under way, 1 it failed, 2 the mode is unknown on this device.
set -eu
modes_dir=/usr/lib/opendap/boot-modes.d

# fail CODE MESSAGE HINT FIX [STATUS]: an error an agent can act on (command standard §5).
fail() { printf 'odap-reboot: error %s: %s\n  hint: %s\n  fix: %s\n' "$1" "$2" "$3" "$4" >&2; exit "${5:-1}"; }

debug_entry() {
  bootctl list --json=short 2>/dev/null | grep -o '"id":"[^"]*@debug"' | head -n1 | cut -d'"' -f4
}

list() {
  echo normal
  [ -n "$(debug_entry)" ] && echo debug
  [ -d "$modes_dir" ] && for m in "$modes_dir"/*; do [ -x "$m" ] && basename "$m"; done
  return 0
}

# The power service (blackbird-power.socket, for the session's composer): one line in, one answer out,
# then the action. Only these requests exist; anything else is refused.
serve() {
  IFS=' ' read -r verb arg rest || exit 0
  [ -z "${rest:-}" ] || { echo "error: one argument at most"; exit 2; }
  case "$verb" in
    list) list ;;
    poweroff) echo ok; exec systemctl poweroff ;;
    reboot)
      m="${arg:-normal}"
      case " $(list | tr '\n' ' ') " in
        *" $m "*) echo ok; exec "$0" "$m" ;;
        *) echo "error: no mode $m on this device"; exit 2 ;;
      esac ;;
    *) echo "error: unknown request"; exit 2 ;;
  esac
}

mode="${1:-normal}"
case "$mode" in
  --serve) serve ;;
  --list) list ;;
  -h|--help) sed -n '2,16s/^# \{0,1\}//p' "$0" ;;
  -*) fail "input.invalid" "unknown flag $mode" "the usage is in odap-reboot --help" "odap-reboot --help" 2 ;;
  normal) exec systemctl reboot ;;
  debug)
    id="$(debug_entry)"
    [ -n "$id" ] || fail "mode.no_debug_entry" "this image has no debug boot entry" \
      "modes here: $(list | tr '\n' ' ')" "odap-reboot --list" 2
    bootctl set-oneshot "$id" || fail "boot.select_failed" "cannot select the debug boot entry $id" \
      "bootctl needs a writable EFI variable store" "bootctl status"
    exec systemctl reboot ;;
  *)
    case "$mode" in */*|.*) fail "mode.unknown" "unknown mode $mode" "a mode is a plain name" "odap-reboot --list" 2 ;; esac
    [ -x "$modes_dir/$mode" ] || fail "mode.unknown" "no mode $mode on this device" \
      "modes here: $(list | tr '\n' ' ')" "odap-reboot --list" 2
    "$modes_dir/$mode" || fail "boot.prepare_failed" "cannot prepare the $mode boot" \
      "the board support package's $modes_dir/$mode failed" "journalctl -b -t odap-reboot"
    exec systemctl reboot ;;
esac
