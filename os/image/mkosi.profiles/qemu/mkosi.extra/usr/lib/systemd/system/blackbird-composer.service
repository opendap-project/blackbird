# The Blackbird OS session (system ADR 0002): blackbird-composer on the first virtual terminal, as the `odap`
# user, in a logind session opened through PAM, so libseat gets the display and input devices
# from logind. Until the orchestrator starts activities, the composer starts the product host.
# The binaries come from Blackbird OS packages, or from a development system extension
# (/var/lib/extensions) during development.
[Unit]
Description=Blackbird OS composer
ConditionPathExists=/usr/lib/blackbird/composer
# The debug boot mode shows a console on the screen instead (getty@tty1).
ConditionKernelCommandLine=!blackbird.debug
After=systemd-user-sessions.service systemd-logind.service systemd-sysext.service blackbird-boot.service
# No Conflicts= with getty@tty1: systemd applies a conflict before conditions, so it would stop
# the debug boot's console. The two exclude each other by condition (blackbird.debug).

[Service]
User=blackbird
# What the composer says to other services (ui-ready: its first frame is on screen).
RuntimeDirectory=blackbird/composer
RuntimeDirectoryPreserve=restart
PAMName=blackbird-composer
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
# The script companions of the design system's type (IBM Plex Sans SC, Arabic, Devanagari), which
# the image installs from Blackbird UI (odapkit image): Slint falls back to fonts loaded from here
# for any glyph Plex Sans lacks, and the activities and the product inherit it.
Environment=SLINT_FONT_PATH=/usr/share/fonts/blackbird
# The composer runs the product host. The activity flag starts a developer activity in its place
# (system SYS-071): BLACKBIRD_ACTIVITY=ui-primitives in a drop-in, or the name in /run/blackbird/composer/activity
# on a running device, then a restart of this unit. The debug UI mode (SYS-070) is its own flag:
# BLACKBIRD_DEBUG_UI=1, or /run/blackbird/debug/ui.
ExecStart=/usr/lib/blackbird/composer -- /usr/lib/blackbird/player
# The boot UI hands the display over and confirms before the composer starts (blackbird-apps-boot handoff);
# without a boot UI it returns at once. Privileged ('+'), and not fatal ('-') without blackbird-apps-boot.
ExecStartPre=-+/usr/lib/blackbird/boot handoff
# When the composer stops (an update, a crash), the boot UI takes the display until the next composer
# is up, instead of the kernel's console (blackbird-apps-boot cover; not while the system shuts down).
# Before the composer is asked to stop, the boot UI is armed; the composer then hands the display over
# on SIGTERM with no blank frame. After a crash, the boot UI takes the display the composer left.
ExecStop=-+/usr/lib/blackbird/boot cover
ExecStopPost=-+/usr/lib/blackbird/boot cover
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
