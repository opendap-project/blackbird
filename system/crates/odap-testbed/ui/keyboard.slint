// The keyboard experiment's parts (input events §3.7, §3.8): a text field, a key of the on-screen
// keyboard, and the panel that stands in for the OS Shell's keyboard.

import { Tokens } from "@blackbird/slint/tokens.slint";
import { Blueprint, Label, FocusReveal, FocusVisible, Layout, Motion } from "@blackbird/slint/components.slint";

// A text field for the keyboard experiment (input events §3.7, §3.8): the box takes the focus like
// any control; editing it is a level, entered by a touch on it or by Action, left by Escape or a tap
// outside, which the screen decides (`editing`). What is typed goes to the logic's form
// (blackbird-ui-forms), which may refuse it (the kind's filter) and says the field's issue once it is left.
export component Field inherits VerticalLayout {
    in property <string> label;
    // The model's text (two-way binding without loops, input events §3.8): it reaches the input
    // only when it says something else than the input shows, so the model echoing what was typed
    // changes nothing, and a normalised value ("+2" for "02") does reach it. Never a `<=>` to the
    // input: typing would break the binding, and the model could no longer reach the field.
    in property <string> text;
    in property <string> issue;
    in property <bool> editing;
    // The scroll area's content origin, in window coordinates: where the field is in the content
    // changes only when the layout above it does (an issue appearing), never with the scroll.
    in property <length> origin;
    callback edit();
    // The text as typed: what to keep (the same, or the text before, when the kind refuses it).
    callback edited(string) -> string;
    callback left();
    out property <bool> focused: input.has-focus;
    public function take() { input.focus(); }
    changed text => { if input.text != root.text { input.text = root.text; } }
    // Editing ends (the keyboard closed): the field is left as far as its value goes.
    changed editing => { if !self.editing { root.left(); } }
    property <length> at: root.absolute-position.y - root.origin;
    changed at => { if input.has-focus { root.report(); } }
    // The whole field is revealed, its caption and its issue with its box: a field brought under
    // the header with its name hidden is not in view.
    changed height => { if input.has-focus { root.report(); } }
    function report() {
        FocusReveal.y = root.absolute-position.y;
        FocusReveal.h = root.height;
        FocusReveal.fixed = false;
        FocusReveal.serial += 1;
    }
    spacing: Tokens.space-unit;
    Label { role: "caption"; muted: true; text: root.label; }
    box := Rectangle {
        height: 48px;
        border-radius: Tokens.radius-control;
        border-width: root.issue != "" ? 2px : 1px;
        border-color: root.issue != "" ? Tokens.state-error : (root.editing && input.has-focus ? Tokens.brand-base : Tokens.border-strong);
        background: Tokens.surface-base;
        // The hidden focus (input events §3.7), as every control keeps it: a navigation key while
        // the ring is hidden only shows where the focus is; typing, Action and back pass through.
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-tab-navigation: false;
            focus-on-click: false;
            capture-key-pressed(e) => {
                if FocusVisible.on || !input.has-focus { return reject; }
                if e.text == Key.Tab || e.text == Key.Backtab || e.text == Key.UpArrow || e.text == Key.DownArrow {
                    FocusVisible.on = true;
                    return accept;
                }
                reject
            }
            input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                vertical-alignment: center;
                single-line: true;
                // What is typed starts at the reading start (the right edge right to left).
                horizontal-alignment: Layout.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                init => { self.text = root.text; }
                color: Tokens.text-primary;
                font-size: Tokens.font-size-body;
                // Its issue is what a screen reader says after its name (aria-describedby).
                accessible-label: root.label;
                // What is typed is what it says it holds: a bare TextInput tells a screen reader
                // its name and nothing of its content.
                accessible-role: text-input;
                accessible-value: self.text;
                accessible-description: root.issue;
                changed has-focus => {
                    if self.has-focus { root.report(); } else { root.left(); }
                }
                edited => {
                    let keep = root.edited(self.text);
                    if keep != self.text { self.text = keep; }
                }
                accepted => { root.edit(); }
            }
        }
        TouchArea {
            clicked => { FocusVisible.on = false; input.focus(); root.edit(); }
        }
        if input.has-focus && FocusVisible.on: Rectangle {
            border-radius: Tokens.radius-control;
            border-width: 2px;
            border-color: Tokens.focus;
        }
    }
    // The issue, tied to the field, shown once it was left (never while first typed).
    if root.issue != "": Label { role: "caption"; text: root.issue; color: Tokens.state-error; }
}

// A key of the experiment's keyboard: a 32 x 46 px target (design system §8.3, the documented
// exception), drawn a little inside it. It never takes the focus: the field keeps it.
export component Key inherits Rectangle {
    in property <string> label;
    callback pressed-key(string);
    height: 46px;
    Rectangle {
        x: 2px;
        y: 3px;
        width: parent.width - 4px;
        height: parent.height - 6px;
        border-radius: 5px;
        background: t.pressed ? Tokens.surface-active : Tokens.surface-raised;
        Label { role: "label"; text: root.label; horizontal-alignment: center; vertical-alignment: center; }
    }
    t := TouchArea { clicked => { root.pressed-key(root.label); } }
}

// The on-screen keyboard's container. On the device the OS Shell places the keyboard's panel through the composer
// (bottom, full width, its height the compositor's) and resizes the
// activity; here it stands in inside the activity, in the same place: docked at the
// bottom, it takes its height from the content area, so the viewport above it shrinks
// (resized, never covered) and the focused field is revealed in what is left.
export component KeyboardPanel inherits Rectangle {
    in property <bool> shown;
    in property <bool> digits;
    callback key(string);
    callback done();
    height: self.shown ? 236px : 0;
    animate height { duration: Motion.reduce ? 0 : 180ms; easing: ease-out; }
    clip: true;
    background: Blueprint.on ? Blueprint.paper : Tokens.surface-base;
    // Every touch on it is its own (hit: self): a tap between keys closes nothing.
    TouchArea { }
    Rectangle { height: 1px; y: 0; background: Tokens.border-base; }
    VerticalLayout {
        y: 0;
        height: 236px;
        padding-top: 8px;
        alignment: start;
        // Its variant follows the field's purpose (text-input-v3): letters, or digits.
        if !root.digits: VerticalLayout {
            for row in [["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"], ["a", "s", "d", "f", "g", "h", "j", "k", "l"], ["z", "x", "c", "v", "b", "n", "m", "⌫"], ["@", ".", "-", ","]]: HorizontalLayout {
                alignment: center;
                for k in row: Key { width: 32px; label: k; pressed-key(t) => { root.key(t); } }
            }
        }
        if root.digits: VerticalLayout {
            for row in [["1", "2", "3", "-"], ["4", "5", "6", ":"], ["7", "8", "9", "⌫"], ["+", "0", "."]]: HorizontalLayout {
                alignment: center;
                for k in row: Key { width: 64px; label: k; pressed-key(t) => { root.key(t); } }
            }
        }
        HorizontalLayout {
            alignment: center;
            Key { width: 192px; label: "space"; pressed-key(t) => { root.key(" "); } }
            Key { width: 64px; label: "Done"; pressed-key(t) => { root.done(); } }
        }
    }
}
