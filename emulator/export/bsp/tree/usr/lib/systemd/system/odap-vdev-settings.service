# The simulator's settings put back at boot (virtual-settings): the debug UI mode, the battery and the
# charger as they were last set, before the composer starts, so its first frame follows them. The
# composer pulls it in (odap-composer.service.d/50-virtual-board.conf).
[Unit]
Description=Virtual board: restore the simulator's settings
DefaultDependencies=no
After=systemd-modules-load.service local-fs.target
Before=odap-composer.service
RequiresMountsFor=/var/lib
ConditionPathExists=/var/lib/odap-vdev/settings

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/opendap/virtual-settings restore
